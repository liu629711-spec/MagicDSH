{
  "name": "@magic/dsh-export",
  "version": "0.1.0",
  "private": true,
  "description": "Magic deliverable export (md -> docx/pdf) host plugin for the MagicDSH base",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "docx": "^9.0.2",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1"
  }
}
