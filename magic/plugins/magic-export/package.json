{
  "name": "@magic/dsh-export",
  "version": "0.1.0",
  "private": true,
  "description": "Magic deliverable export (md -> docx/pdf) host plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node --test tests/*.test.ts",
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "dependencies": {
    "docx": "^9.0.2",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1"
  }
}
